# Brute Force Appoach (TLE)
class Solution:
    def countNonDecreasingSubarrays(self, nums: List[int], k: int) -> int:
        n = len(nums)
        result = 0

        def check(nums,k):
            count = 0
            maxi = nums[0]
            for i in range(1,len(nums)):
                maxi = max(maxi, nums[i])
                if nums[i] < maxi:
                    count += maxi - nums[i]

                if count > k:
                    return False

            return True

        for i in range(n):
            for j in range(i,n):
                if check(nums[i:j+1],k):
                    result += 1

        return result
