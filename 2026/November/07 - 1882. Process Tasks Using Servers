class Solution:
    def assignTasks(self, servers: list[int], tasks: list[int]) -> list[int]:
        free = []
        busy = []

        for i in range(len(servers)):
            heapq.heappush(free, (servers[i], i))

        result = []
        time = 0

        for i in range(len(tasks)):

            time = max(time, i)

            # Move completed servers to free heap
            while busy and busy[0][0] <= time:
                finish, weight, idx = heapq.heappop(busy)
                heapq.heappush(free, (weight, idx))

            # If no server is free, wait
            if not free:
                time = busy[0][0]

                while busy and busy[0][0] <= time:
                    finish, weight, idx = heapq.heappop(busy)
                    heapq.heappush(free, (weight, idx))

            # Select the best free server
            weight, idx = heapq.heappop(free)

            result.append(idx)

            # Put the server into busy heap
            heapq.heappush(busy, (time + tasks[i], weight, idx))

        return result
